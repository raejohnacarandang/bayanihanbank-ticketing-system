# ---------------------------------------------------------------------------
# MySQL database (replaces data/db.json persistence)
# ---------------------------------------------------------------------------

# Host / port of the MySQL server (XAMPP default: 127.0.0.1:3306)
DB_HOST="127.0.0.1"
DB_PORT="3306"

# Database credentials. Create a dedicated MySQL user with privileges limited to
# DB_NAME only (e.g. GRANT ALL PRIVILEGES ON bayanihan_bank.* TO 'app'@'localhost').
# Do NOT use the MySQL root account in production.
DB_USER="bb_servicedesk"
DB_PASSWORD="CHANGE_ME_to_a_long_random_secret"

# Database name; created automatically on first run.
DB_NAME="bayanihan_bank"

# Secret used to sign session JWTs. Set a long random value in production.
# If omitted, a well-known demo default is used.
JWT_SECRET="CHANGE_ME_to_a_long_random_secret"

# CSRF_SECRET: Secret used to sign CSRF tokens. Set a long random value in production.
CSRF_SECRET="CHANGE_ME_to_a_long_random_secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3001"

# DEMO_MODE: When "false" (production), demo accounts are NOT seeded and only a
# single bootstrap admin is created with a random one-time password (printed to
# the server log on first run). /api/auth/demo-accounts is also disabled.
# Set to "true" for local demo/dev.
DEMO_MODE="true"

# ADMIN_RECOVERY_KEY: Operator key that lets an administrator self-reset their
# own password from the login screen if forgotten (no login required). Keep it
# safe — it bypasses the admin login. If omitted, admin self-recovery is disabled
# and a forgotten admin password must be reset on the server instead.
ADMIN_RECOVERY_KEY="CHANGE_ME_to_a_long_random_secret"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
