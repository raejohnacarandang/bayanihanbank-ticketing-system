import React, { useEffect, useRef } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { useToast } from './useToast';
import { X, CheckCircle2, AlertCircle, AlertTriangle, Info, RotateCcw } from 'lucide-react';

const typeStyles: Record<string, { bg: string; icon: string; border: string }> = {
  success: { bg: 'bg-emerald-50', icon: 'text-emerald-600', border: 'border-emerald-200' },
  error: { bg: 'bg-red-50', icon: 'text-red-600', border: 'border-red-200' },
  warning: { bg: 'bg-amber-50', icon: 'text-amber-600', border: 'border-amber-200' },
  info: { bg: 'bg-sky-50', icon: 'text-sky-600', border: 'border-sky-200' },
};

const typeIcons: Record<string, React.ReactNode> = {
  success: <CheckCircle2 className="w-5 h-5" />,
  error: <AlertCircle className="w-5 h-5" />,
  warning: <AlertTriangle className="w-5 h-5" />,
  info: <Info className="w-5 h-5" />,
};

export function ToastContainer() {
  const { toasts, removeToast } = useToast();

  return (
    <AnimatePresence>
      {toasts.map(toast => {
        const styles = typeStyles[toast.type];
        const Icon = typeIcons[toast.type];

        return (
          <motion.div
            key={toast.id}
            initial={{ opacity: 0, x: 100, y: 20 }}
            animate={{ opacity: 1, x: 0, y: 0 }}
            exit={{ opacity: 0, x: 100, y: 20, scale: 0.95 }}
            transition={{ duration: 0.3, ease: [0.16, 1, 0.3, 1] }}
            className={`fixed bottom-4 right-4 z-50 w-full max-w-sm sm:max-w-md ${styles.bg} border ${styles.border} rounded-xl shadow-lg p-4 flex items-start gap-3`}
            style={{ zIndex: 9999 }}
          >
            <div className={`flex-shrink-0 ${styles.icon} mt-0.5`}>
              {Icon}
            </div>
            
            <div className="flex-1 min-w-0">
              <div className="flex items-start justify-between gap-2">
                <div className="flex-1 min-w-0">
                  <h4 className="font-semibold text-slate-900 text-sm">{toast.title}</h4>
                  {toast.message && (
                    <p className="text-slate-600 text-sm mt-0.5">{toast.message}</p>
                  )}
                </div>
                <button type="button"
                  onClick={() => removeToast(toast.id)}
                  className="flex-shrink-0 text-slate-400 hover:text-slate-600 transition p-1"
                  aria-label="Dismiss"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>

              {toast.action && (
                <button type="button"
                  onClick={() => {
                    toast.action!.onClick();
                    removeToast(toast.id);
                  }}
                  className="mt-3 text-sm font-semibold text-primary-600 hover:text-primary-700 underline"
                >
                  {toast.action.label}
                </button>
              )}

              {toast.undo && (
                <motion.div
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: 'auto' }}
                  exit={{ opacity: 0, height: 0 }}
                  className="mt-3 pt-3 border-t border-slate-200"
                >
                  <button type="button"
                    onClick={() => {
                      toast.undo!.onClick();
                      removeToast(toast.id);
                    }}
                    className="flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-slate-900"
                  >
                    <RotateCcw className="w-4 h-4" />
                    {toast.undo.label}
                  </button>
                </motion.div>
              )}
            </div>
          </motion.div>
        );
      })}
    </AnimatePresence>
  );
}

export function Toaster() {
  return <ToastContainer />;
}