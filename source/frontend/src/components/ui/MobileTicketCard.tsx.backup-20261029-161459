import React, { useState, useRef, useEffect, useCallback } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  Eye, 
  MessageSquare, 
  Flag, 
  MoreVertical,
  User,
  Calendar,
  Clock,
  MapPin,
  Tag,
  AlertTriangle,
  CheckCircle2,
  ExternalLink,
  ChevronRight,
  ChevronLeft,
  Archive,
  Trash2,
  Edit,
  Copy,
  Download,
  ShieldCheck,
  Zap,
  Activity,
  Building2,
} from 'lucide-react';
import { useFeatureFlag } from '../../hooks/useFeatureFlags';

interface MobileTicketCardProps {
  ticket: {
    id: string;
    subject: string;
    description: string;
    status: 'In Progress' | 'Resolved';
    priority: 'Critical' | 'High' | 'Medium' | 'Low';
    category: string;
    branch: string;
    branchId: string;
    reporter: { name: string; avatar?: string };
    assignee?: { name: string; avatar?: string; id: string };
    createdAt: string;
    updatedAt: string;
    tags?: string[];
    slaDeadline?: string;
    isOverSLA?: boolean;
    timeTracked?: number;
    unreadComments?: number;
  };
  onClick: () => void;
  onLongPress?: () => void;
  onSwipeRight?: () => void;
  onSwipeLeft?: () => void;
  isSelected?: boolean;
  onSelect?: (id: string, multi?: boolean) => void;
  showSwipeActions?: boolean;
  compact?: boolean;
  showTimeTracked?: boolean;
}

const PRIORITY_COLORS = {
  Critical: { bg: 'bg-red-100', text: 'text-red-700', border: 'border-red-200', icon: '🔴' },
  High: { bg: 'bg-amber-100', text: 'text-amber-700', border: 'border-amber-200', icon: '🟠' },
  Medium: { bg: 'bg-sky-100', text: 'text-sky-700', border: 'border-sky-200', icon: '🔵' },
  Low: { bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200', icon: '⚪' },
};

const STATUS_COLORS = {
  'In Progress': { bg: 'bg-amber-100', text: 'text-amber-700', border: 'border-amber-200' },
  'Resolved': { bg: 'bg-emerald-100', text: 'text-emerald-700', border: 'border-emerald-200' },
};

const FALLBACK_PRIORITY_STYLE = { bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200', icon: '⚪' };
const FALLBACK_STATUS_STYLE = { bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200' };

export function MobileTicketCard({
  ticket,
  onClick,
  onLongPress,
  onSwipeRight,
  onSwipeLeft,
  isSelected = false,
  onSelect,
  showSwipeActions = true,
  compact = false,
  showTimeTracked = true,
}: MobileTicketCardProps) {
  const enabled = useFeatureFlag('drag-drop');
  const [showActions, setShowActions] = useState(false);
  const [dragOffset, setDragOffset] = useState(0);
  const [isDragging, setIsDragging] = useState(false);
  const cardRef = useRef<HTMLDivElement>(null);
  const startX = useRef(0);
  const longPressTimer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);

  const priorityStyle = PRIORITY_COLORS[ticket.priority] ?? FALLBACK_PRIORITY_STYLE;
  const statusStyle = STATUS_COLORS[ticket.status] ?? FALLBACK_STATUS_STYLE;
  const isOverSLA = ticket.isOverSLA;

  const handleTouchStart = useCallback((e: React.TouchEvent) => {
    const touch = e.touches[0];
    startX.current = touch.clientX;
    longPressTimer.current = setTimeout(() => {
      onLongPress?.();
    }, 500);
  }, [onLongPress]);

  const handleTouchMove = useCallback((e: React.TouchEvent) => {
    if (e.touches.length > 1) return;
    
    const touch = e.touches[0];
    const deltaX = touch.clientX - startX.current;
    
    // Only allow horizontal drag if vertical scroll isn't happening
    if (Math.abs(deltaX) > Math.abs(touch.clientY - (e.touches[0] as any).clientY)) {
      e.preventDefault();
      
      if (Math.abs(deltaX) > 10) {
        setIsDragging(true);
        const clampedDrag = Math.max(-100, Math.min(100, deltaX * 0.5));
        setDragOffset(clampedDrag);
      }
    }
  }, []);

  const handleTouchEnd = useCallback(() => {
    clearTimeout(longPressTimer.current);
    
    if (isDragging) {
      if (dragOffset > 50) {
        // Swipe right - quick action
        if (showSwipeActions) onSwipeRight?.();
      } else if (dragOffset < -50) {
        // Swipe left - delete/archive
        if (showSwipeActions) onSwipeLeft?.();
      }
    }
    
    setIsDragging(false);
    setDragOffset(0);
  }, [dragOffset, isDragging, onSwipeRight, onSwipeLeft, showSwipeActions]);

  useEffect(() => {
    if (isDragging) {
      const handleMove = (e: TouchEvent) => {
        const touch = e.touches[0];
        const deltaX = touch.clientX - startX.current;
        if (Math.abs(deltaX) > Math.abs(touch.clientY - (touch as any).clientY)) {
          e.preventDefault();
          const clampedDrag = Math.max(-100, Math.min(100, deltaX * 0.5));
          setDragOffset(clampedDrag);
        }
      };
      
      window.addEventListener('touchmove', handleMove as any, { passive: false });
      return () => window.removeEventListener('touchmove', handleMove as any);
    }
  }, [isDragging]);

  const formatTimeAgo = (dateStr: string) => {
    const date = new Date(dateStr);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    if (diffDays < 7) return `${diffDays}d ago`;
    return date.toLocaleDateString();
  };

  const formatDuration = (seconds: number) => {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    return `${h}h ${m}m`;
  };

  const cardStyle = {
    transform: isDragging ? `translateX(${dragOffset}px)` : undefined,
    opacity: isDragging ? 0.9 : 1,
    borderLeft: isSelected ? '4px solid #10b981' : undefined,
    backgroundColor: isSelected ? '#f0fdf4' : undefined,
  } as React.CSSProperties;

  return (
    <motion.div
      ref={cardRef}
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, x: -100 }}
      transition={{ duration: 0.2 }}
      onTouchStart={handleTouchStart}
      onTouchMove={handleTouchMove}
      onTouchEnd={handleTouchEnd}
      onClick={onClick}
      onContextMenu={e => { e.preventDefault(); onLongPress?.(); }}
      className={`relative group overflow-hidden rounded-xl border transition-all duration-200 ${
        isSelected 
          ? 'bg-emerald-50 border-emerald-200 ring-2 ring-emerald-500/20' 
          : 'bg-white border-slate-200 hover:bg-slate-50'
      }`}
      style={cardStyle}
    >
      {/* Swipe Action Indicators */}
      <AnimatePresence>
        {dragOffset > 20 && (
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -20 }}
            className="absolute inset-0 bg-emerald-50/50 flex items-center justify-start pl-6 pointer-events-none z-10 rounded-xl"
          >
            <div className="flex items-center gap-2 text-emerald-700 font-medium">
              <CheckCircle2 className="w-5 h-5" />
              <span>Mark Resolved</span>
            </div>
          </motion.div>
        )}
        {dragOffset < -20 && (
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: 20 }}
            className="absolute inset-0 bg-red-50/50 flex items-center justify-end pr-6 pointer-events-none z-10 rounded-xl"
          >
            <div className="flex items-center gap-2 text-red-700 font-medium">
              <span>Archive</span>
              <Trash2 className="w-5 h-5" />
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Card Content */}
      <div className="p-4 sm:p-5">
        {/* Header Row */}
        <div className="flex items-start justify-between gap-3 mb-3">
          <div className="flex items-center gap-2 flex-1 min-w-0">
            <input
              type="checkbox"
              checked={isSelected}
              onChange={(e) => onSelect?.(ticket.id, e.shiftKey)}
              onClick={(e) => e.stopPropagation()}
              className="w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-2 focus:ring-emerald-500 shrink-0"
            />
            
            <div className="flex items-center gap-1.5 flex-wrap">
              <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${priorityStyle.bg} ${priorityStyle.text} ${priorityStyle.border} shrink-0`}>
                {priorityStyle.icon} {ticket.priority}
              </span>
              <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border} shrink-0`}>
                {ticket.status}
              </span>
              {isOverSLA && (
                <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-700 border border-red-200 shrink-0 flex items-center gap-1">
                  <AlertTriangle className="w-3 h-3" />
                  Over SLA
                </span>
              )}
            </div>
          </div>
          
          <div className="flex items-center gap-1">
            <span className="text-[10px] text-slate-400 font-mono shrink-0">
              {formatTimeAgo(ticket.createdAt)}
            </span>
          </div>
        </div>

        {/* Subject */}
        <h3 className="font-semibold text-slate-900 mb-2 line-clamp-2" onClick={(e) => e.stopPropagation()}>
          {ticket.subject}
        </h3>

        {/* Description Preview */}
        <p className="text-sm text-slate-600 line-clamp-2 mb-3" onClick={(e) => e.stopPropagation()}>
          {ticket.description}
        </p>

        {/* Meta Info */}
        <div className="flex items-center gap-3 text-xs text-slate-500 flex-wrap mb-3">
          <span className="flex items-center gap-1">
            <User className="w-3.5 h-3.5" />
            {ticket.assignee?.name || 'Unassigned'}
          </span>
          <span className="flex items-center gap-1">
            <MapPin className="w-3.5 h-3.5" />
            {ticket.branch}
          </span>
          <span className="flex items-center gap-1">
            <Calendar className="w-3.5 h-3.5" />
            {formatTimeAgo(ticket.createdAt)}
          </span>
          {ticket.category && (
            <span className="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">
              {ticket.category}
            </span>
          )}
        </div>

        {/* SLA / Time Tracked */}
        {(ticket.slaDeadline || showTimeTracked) && (
          <div className="pt-3 border-t border-slate-100">
            {ticket.slaDeadline && (
              <div className="flex items-center gap-2 text-xs mb-2">
                <Flag className="w-3.5 h-3.5 text-amber-500" />
                <span className="font-medium text-slate-700">
                  SLA: {new Date(ticket.slaDeadline).toLocaleString()}
                </span>
                {isOverSLA && (
                  <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-100 text-red-700">
                    OVERDUE
                  </span>
                )}
              </div>
            )}
            {showTimeTracked && ticket.timeTracked && (
              <div className="flex items-center gap-2 text-xs text-slate-500">
                <Clock className="w-3.5 h-3.5" />
                <span>Tracked: {formatDuration(ticket.timeTracked)}</span>
              </div>
            )}
          </div>
        )}

        {/* Tags */}
        {ticket.tags && ticket.tags.length > 0 && (
          <div className="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-slate-100">
            {ticket.tags.slice(0, 4).map((tag) => (
              <span key={tag} className="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600">
                #{tag}
              </span>
            ))}
            {ticket.tags.length > 4 && (
              <span className="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-400">
                +{ticket.tags.length - 4} more
              </span>
            )}
          </div>
        )}

        {/* Quick Actions Bar */}
        <div className="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <button type="button" className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition" aria-label="View">
              <Eye className="w-4.5 h-4.5" />
            </button>
            {ticket.unreadComments && ticket.unreadComments > 0 && (
              <button type="button" className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition relative" aria-label="Comments">
                <MessageSquare className="w-4.5 h-4.5" />
                <span className="absolute -top-1 -right-1 w-4 h-4 bg-sky-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center">
                  {ticket.unreadComments}
                </span>
              </button>
            )}
          </div>
          
          <div className="flex items-center gap-1">
            <button type="button" className="p-2 rounded-lg hover:bg-slate-100 text-slate-500 hover:text-slate-700 transition" aria-label="More">
              <MoreVertical className="w-4.5 h-4.5" />
            </button>
          </div>
        </div>
      </div>
    </motion.div>
  );
}

// Swipe Action Indicators
function SwipeIndicator({ 
  children, 
  color = 'emerald', 
  offset 
}: { 
  children: React.ReactNode; 
  color?: 'emerald' | 'red' | 'amber';
  offset: number;
}) {
  if (Math.abs(offset) < 20) return null;
  
  const bgColor = color === 'emerald' ? 'bg-emerald-50/50' : 
                  color === 'red' ? 'bg-red-50/50' : 'bg-amber-50/50';
  const textColor = color === 'emerald' ? 'text-emerald-700' : 
                    color === 'red' ? 'text-red-700' : 'text-amber-700';
  const borderColor = color === 'emerald' ? 'border-emerald-200' : 
                      color === 'red' ? 'border-red-200' : 'border-amber-200';

  const isRight = offset > 0;

  return (
    <div className={`absolute inset-0 ${bgColor} flex items-center justify-${isRight ? 'start' : 'end'} p-6 pointer-events-none z-10 rounded-xl ${borderColor} border-2`}>
      <div className={`flex items-center gap-2 ${textColor} font-medium ${isRight ? '' : 'flex-row-reverse'}`}>
        {children}
      </div>
    </div>
  );
}