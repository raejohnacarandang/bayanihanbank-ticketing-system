{
  "name": "bayanihan-ticketing-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n php,web -c blue,green \"php -S 0.0.0.0:3002 -t ../php-backend -d max_execution_time=300 -d memory_limit=256M ../php-backend/router.php\" \"cross-env API_PORT=3002 vite --port=3000 --host=0.0.0.0\"",
    "dev:php": "npm run dev",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:php-server": "php -S 0.0.0.0:3002 -t ../php-backend -d max_execution_time=300 -d memory_limit=256M ../php-backend/router.php",
    "build": "vite build",
    "build:hostgator": "node ../tools/build-hostgator.mjs",
    "gen:env": "node ../tools/gen-prod-env.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "reset:data": "php ../php-backend/scripts/reset-demo-data.php",
    "force-password-reset": "php ../php-backend/scripts/force-password-reset.php",
    "set-password": "php ../php-backend/scripts/set-password.php",
    "migrate-passwords": "php ../php-backend/scripts/migrate_passwords.php",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
